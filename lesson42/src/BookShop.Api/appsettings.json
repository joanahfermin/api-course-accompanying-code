{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BookShop": "Data Source=bookshop.db"
  },
  "Jwt": {
    "Issuer": "BookShop.Api",
    "Audience": "BookShop",
    "MinutesValid": 60
  }
}
